DEBUG=True

# Datos de conexion al pooler de Supabase (Settings > Database en el dashboard)
DB_NAME=postgres
DB_USER=postgres.wsqcmzqcklftwoejhiye
DB_PASSWORD=
DB_HOST=aws-0-ca-central-1.pooler.supabase.com
DB_PORT=5432

# OpenAI (cerebro de los agentes)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Modelo solo para el veredicto del Agente de Ahorro, que necesita ponderar varios
# factores a la vez. Opcional: si no se define, usa gpt-4o. Bajarlo a gpt-4o-mini
# abarata pero vuelve al agente muy conservador (rechaza casi todo lo que toque el
# ahorro, y a veces con motivos incorrectos).
OPENAI_MODEL_VEREDICTO=gpt-4o

# Secreto compartido que n8n debe mandar en el header X-Webhook-Secret al pegarle a /api/pulso/
# y /api/comando/
N8N_WEBHOOK_SECRET=

# URLs de los workflows de n8n (las "manos"/"voz"). Si quedan vacias, Django
# loguea y sigue sin romper la demo.
N8N_WHATSAPP_WEBHOOK_URL=
N8N_KEEP_WEBHOOK_URL=
N8N_CALENDAR_WEBHOOK_URL=
# Workflow 'Decisiones': manda al Telegram del hogar las decisiones del Agente de
# Despensa y del Agente de Mantenimiento (ver n8n/workflow_decisiones.json).
N8N_TELEGRAM_WEBHOOK_URL=
