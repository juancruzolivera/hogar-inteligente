{
  "name": "Consulta de Compra - Hogar Inteligente",
  "nodes": [
    {
      "id": "telegram-trigger",
      "name": "Mensaje de Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        260,
        300
      ],
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "post-consulta",
      "name": "POST /api/consulta/",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DJANGO_BASE_URL }}/api/consulta/",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ telegram_id: $json.message.from.id, mensaje: $json.message.text || '(sin texto)' }) }}",
        "options": {}
      }
    },
    {
      "id": "responder-telegram",
      "name": "Responder en el chat",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        780,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Mensaje de Telegram').item.json.message.chat.id }}",
        "text": "={{ $json.respuesta }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    }
  ],
  "connections": {
    "Mensaje de Telegram": {
      "main": [
        [
          {
            "node": "POST /api/consulta/",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /api/consulta/": {
      "main": [
        [
          {
            "node": "Responder en el chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
